   "maps_it_lowers": 2,
   "says": "a wall of type 511 (kWallGib) with the channel it fires and what it opens onto",
   "signature": "breakable(surface, *, on=, reveals=)",
   "total": 24,
   "why_a_macro": "layer 8 refuses to name these because the taught course has no lesson of type 511 at all -- the campaign uses a mechanism its own course omits"
  },
  "channel": {
   "cause": "construct",
   "lowers": {
    "E1M2": 72,
    "E3M1": 41,
    "E4M8": 8
   },
   "maps_it_lowers": 3,
   "says": "one channel with its transmitters and its receivers as a single construct. The campaign fans a channel out to as many records as it likes; our writer wires one pair",
   "signature": "channel(number, tx=[...], rx=[...], *, on=, wave=)",
   "total": 121,
   "why_a_macro": "the residue is records that transmit or listen on a channel no sentence reaches, which is what a one-pair writer produces"
  },
  "dressing": {
   "cause": "construct",
   "lowers": {
    "E1M2": 371,
    "E3M1": 330,
    "E4M8": 72
   },
   "maps_it_lowers": 3,
   "says": "a bundle of unwired sprites placed against an anchor -- a table with its bottles, a shelf with its books. The reader that names them already exists (read_intent.named_props and anchors.find_bundles); nothing authors them",
   "signature": "dressing(anchor, [prop...], *, spread=, facing=)",
   "total": 773,
   "why_a_macro": "the residue is one fact per sprite and every sprite is decoration our language cannot place except by absolute coordinate"
  },
  "self_lit": {
   "cause": "construct",
   "lowers": {
    "E1M2": 21,
    "E3M1": 39,
    "E4M8": 1
   },
   "maps_it_lowers": 3,
   "says": "a sector that lights itself: an XSECTOR carrying a light wave and no motion, no key and no channel",
   "signature": "self_lit(space, amplitude=, phase=, wave=)",
   "total": 61,
   "why_a_macro": "the reader can read it and calls it residue only because it is not a mechanism; it is a lighting construct with no home in the language"
  },
  "stair": {
   "cause": "construct",
   "lowers": {
    "E1M2": 102,
    "E3M1": 219,
    "E4M8": 0
   },
   "maps_it_lowers": 2,
   "says": "a stepped run as one construct owning every tread and the projection across them, rather than N sectors each fitted its own frame",
   "signature": "stair(from_, to, *, treads=, width=, clear_height=)",
   "total": 321,
   "why_a_macro": "a tread is its own sector, so its side walls have no same-material neighbour and layer 2 cannot attest a frame on any of them"
  }
 },
