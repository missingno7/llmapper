__pycache__/
*.py[cod]
*.egg-info/
.coverage
work/

# The regression corpora come from commercial games and are supplied locally by
# each developer. Keep the setup notes, never redistribute original maps.
maps/*
!maps/README.md

# Rendered original-map geometry is a local diagnostic artifact.
reports/*.svg

# Local game data and upstream source checkouts used as development oracles.
# This tree may contain commercial assets and is never part of the repository.
reference/

# Render frames and observation dumps from the visual loops. They are
# regenerable from the sources, they are large (135M for blood-city alone),
# and the reference frames among them are renders of commercial maps, which
# this repository does not redistribute.
projects/*/reports/looks/
projects/*/level/reports/looks/
projects/*/reports/pilot-views/
projects/*/references/plots/

# The same category, written under a project's own reports and references by
# the newer visual loops and precedent miners: sweep-*, *-views, and the
# per-source directories a mine leaves beside its report. Each holds rendered
# frames and, for a mined precedent, an architecture-only copy of the source
# map -- a commercial level with its dressing stripped is still a commercial
# level. 33M under blood-city alone, all regenerable from the miners and the
# build script beside them.
#
# A mined precedent's artifact is its flat report pair (e6m1-shop.{json,md});
# the directory next to it is the dump. Nothing under references/ that is a
# directory has ever been tracked, so none of them are.
projects/*/reports/*-views/
projects/*/reports/sweep-*/
projects/*/references/*/

# XMapEdit, checked out beside NBlood as a second engine oracle. 163M of
# third-party source with its own history; read, never redistributed.
xmapedit/

# Observation dumps from the visual loop -- the same category as
# projects/*/reports/looks above, but written at the tree root by the ad-hoc
# render harness. 26M and regenerable from the sources.
.obs/

# NBlood's runtime state, written next to the binary when a map is smoke
# tested. Machine-local and rewritten on every run.
nblood.cfg
nblood_cvars.cfg
nblood.log
texturecache
texturecache.index

# XMapEdit's autosaves. The editor writes these beside whatever map is open;
# the authored source is the .py beside them.
ASAVE*.map
ASAVE*.bak
